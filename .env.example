# =========================================
# Variables de docker-compose (todas opcionales)
# Copia este archivo como .env en la raíz del proyecto solo si quieres cambiar algo.
# El archivo .env nunca se sube a GitHub.
# =========================================

# Contraseña de la base de datos dentro de Docker.
POSTGRES_PASSWORD=senderia_local

# Secreto para firmar sesiones (mínimo 32 caracteres). Vacío = se genera uno al iniciar.
JWT_SECRET=

# Cuenta administradora creada al iniciar (contraseña de 12 caracteres o más).
ADMIN_NAME=Administrador Senderia
ADMIN_EMAIL=admin@senderia.cl
ADMIN_PASSWORD=SenderiaAdmin2026

# Inicio de sesión con Google: Client ID web de Google Cloud (no es secreto).
# Debe tener autorizado el origen http://localhost:8100. Vacío = el botón de Google no se muestra.
GOOGLE_CLIENT_ID=

# Envío real de códigos por Gmail (contraseña de aplicación). Esta sí es secreta.
# Vacío = modo desarrollo: los códigos aparecen con "docker compose logs api".
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Opcional: coordenadas automáticas al crear destinos.
GEOAPIFY_API_KEY=

# Puertos en tu computador (cámbialos solo si ya están ocupados).
# Si cambias WEB_HOST_PORT, actualiza también CORS_ORIGINS y el origen autorizado en Google.
WEB_HOST_PORT=8100
API_HOST_PORT=3000
DB_HOST_PORT=5433
CORS_ORIGINS=http://localhost:8100
VITE_API_URL=http://localhost:3000/api
