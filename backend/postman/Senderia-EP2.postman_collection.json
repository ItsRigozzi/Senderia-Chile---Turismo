{
  "info": {
    "name": "Senderia Chile - EP2 API",
    "description": "Pruebas reproducibles de persistencia PostgreSQL, JWT, roles y CRUD. Ejecutar en orden con backend y base configurados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "adminEmail", "value": "admin@senderia.cl" },
    { "key": "adminPassword", "value": "" },
    { "key": "token", "value": "" },
    { "key": "turistaEmail", "value": "" },
    { "key": "turistaPassword", "value": "" },
    { "key": "turistaToken", "value": "" },
    { "key": "categoriaId", "value": "" },
    { "key": "regionId", "value": "" },
    { "key": "destinoId", "value": "" },
    { "key": "usuarioId", "value": "" }
  ],
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('API activa', () => pm.response.to.have.status(200));"] } }] },
    { "name": "Login admin", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login exitoso', () => pm.response.to.have.status(200));", "pm.environment.set('token', pm.response.json().token);"] } }] },
    { "name": "Registrar turista", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Turista EP2\",\n  \"email\": \"{{turistaEmail}}\",\n  \"password\": \"{{turistaPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Registro persistido de turista', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('turistaToken', pm.response.json().token);"] } }] },
    { "name": "Login admin", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login exitoso', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('token', pm.response.json().token);"] } }] },
    { "name": "Usuario actual (JWT)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/auth/me" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Token identifica usuario', () => pm.response.to.have.status(200));"] } }] },
    { "name": "Listar categorías", "request": { "method": "GET", "url": "{{baseUrl}}/categorias" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Lista categorías', () => pm.response.to.have.status(200));", "const rows = pm.response.json().categorias;", "if (rows.length) pm.collectionVariables.set('categoriaId', rows[0].id);"] } }] },
    { "name": "Listar regiones", "request": { "method": "GET", "url": "{{baseUrl}}/categorias/regiones" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Lista regiones', () => pm.response.to.have.status(200));", "const rows = pm.response.json().regiones;", "if (rows.length) pm.collectionVariables.set('regionId', rows[0].id);"] } }] },
    { "name": "Crear destino (admin CRUD)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Destino temporal de prueba EP2\",\n  \"descripcion\": \"Registro temporal para demostrar el CRUD\",\n  \"categoria_id\": {{categoriaId}},\n  \"region_id\": {{regionId}},\n  \"latitud\": -33.45,\n  \"longitud\": -70.66,\n  \"horario\": \"Acceso libre\"\n}" }, "url": "{{baseUrl}}/destinos" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Destino persistido', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('destinoId', pm.response.json().destino.id);"] } }] },
    { "name": "Leer destinos", "request": { "method": "GET", "url": "{{baseUrl}}/destinos" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Consulta catálogo persistido', () => pm.response.to.have.status(200));", "pm.test('Origen PostgreSQL', () => pm.expect(pm.response.json().source).to.eql('database'));"] } }] },
    { "name": "Editar destino", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Destino temporal EP2 editado\"\n}" }, "url": "{{baseUrl}}/destinos/{{destinoId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Destino editado', () => pm.response.to.have.status(200));"] } }] },
    { "name": "Permiso admin requerido", "request": { "method": "POST", "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/destinos" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Rechaza petición anónima', () => pm.response.to.have.status(401));"] } }] },
    { "name": "Rol turista no puede crear destinos", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{turistaToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/destinos" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Rechaza rol turista', () => pm.response.to.have.status(403));"] } }] },
    { "name": "Eliminar destino de prueba", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/destinos/{{destinoId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Destino eliminado', () => pm.response.to.have.status(200));"] } }] }
  ]
}
