PORT=3000
# Dirección donde escucha la API. 0.0.0.0 es necesario dentro de Docker; usa 127.0.0.1 para limitarla a tu equipo.
HOST=0.0.0.0
# Orígenes del frontend autorizados por CORS, separados por coma (sin "/" final y nunca "*").
CORS_ORIGINS=http://localhost:5173,http://localhost:8100
DB_HOST=localhost
DB_PORT=5432
DB_NAME=senderia
DB_USER=postgres
DB_PASSWORD=tu_password
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES
DB_SSL=false
# Opcional: permite crear destinos solo con nombre y región; las coordenadas se guardan en PostgreSQL.
GEOAPIFY_API_KEY=

# Google Identity Services: use the same OAuth Web Client ID in backend and frontend.
GOOGLE_CLIENT_ID=

# SMTP for one-time email verification and password recovery codes.
# Port 587 uses STARTTLS; use SMTP_SECURE=true for port 465.
# Modo desarrollo: si SMTP_USER o SMTP_PASS quedan vacíos (y NODE_ENV no es production),
# los códigos no se envían por correo y se muestran en la consola del backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sendería Chile <no-reply@example.com>
AUTH_EMAIL_CODE_TTL_MINUTES=10
